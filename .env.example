# Copy to .env. Local secrets are also auto-created under /data if missing.

# Required in production (Railway). 32+ characters each.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_ENCRYPTION_KEY=change-me-to-another-long-random-hex-or-passphrase

# Local default: embedded PGlite (no Docker). Production: Railway Postgres plugin.
# DATABASE_URL=postgresql://shelf:shelf@localhost:5432/shelf

# Plaid — leave empty to use the app with sample data only.
# Dashboard: https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Optional. Required for real-bank OAuth on iOS (Chase, etc.)
PLAID_REDIRECT_URI=http://localhost:3000/api/plaid/oauth
# Android package for Plaid Link. Matches the Expo app id.
PLAID_ANDROID_PACKAGE=app.shelf.mobile
# Optional. Production webhooks; localhost uses polling instead.
PLAID_WEBHOOK_URL=

# Public server URL (Railway). The phone app uses this as EXPO_PUBLIC_API_URL.
# NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app
# EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_GATE_TOKEN=

# Optional locally. Used only until Google sign-in is configured.
# With GOOGLE_CLIENT_ID set, the site is public and Google is the door.
APP_GATE_TOKEN=

# Sign in with Google. When both are set, only GOOGLE_ALLOWED_EMAIL can open Shelf.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAIL=rico21r@gmail.com
